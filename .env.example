# Copy to .env and fill in the sandbox access token.
# The token is a secret. Never commit .env.
#
# Sandbox only, until you deliberately switch. Production is refused
# unless SQUARE_ENV=production and SQUARE_ALLOW_PRODUCTION=yes.

SQUARE_ENV=sandbox
SQUARE_APPLICATION_ID=sandbox-sq0idb-rqkEoTTcR7FYJQCQiDjBYw
SQUARE_LOCATION_ID=LFXEWDVVKRYC0
# Optional per-store location ids. Both fall back to SQUARE_LOCATION_ID.
# SQUARE_LOCATION_FINDON=
# SQUARE_LOCATION_GRANGE=
SQUARE_ACCESS_TOKEN=
SQUARE_CURRENCY=AUD

# Which site config to serve. roccos | margherita | hungry-italian
BRAND=roccos
PORT=3000

# Where catering, gift card, and club forms should be emailed.
# Placeholder until the shop names the inbox.
ENQUIRY_EMAIL=placeholder@example.com
# Optional. When set, the server also POSTs each form submission here as JSON.
# ENQUIRY_WEBHOOK_URL=
